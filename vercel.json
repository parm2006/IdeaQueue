{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/.well-known/oauth-protected-resource", "destination": "/api/oauth?action=resource" },
    { "source": "/.well-known/oauth-protected-resource/api/mcp", "destination": "/api/oauth?action=resource" },
    { "source": "/.well-known/oauth-authorization-server", "destination": "/api/oauth?action=metadata" },
    { "source": "/connect", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
